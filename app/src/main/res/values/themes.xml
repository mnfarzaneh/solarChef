<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style
        name="Theme.SolalrChef"
        parent="android:Theme.Material.Light.NoActionBar" />

    <style
        name="Theme.App.Starting"
        parent="Theme.SplashScreen">

        <!-- نزدیک به رنگ غالب اولین فریم Oven -->
        <item name="windowSplashScreenBackground">
            @color/splash_background
        </item>

        <!-- لوگو از اولین فریم Splash سیستمی دیده می‌شود؛ صفحهٔ کرم خالی نداریم. -->
        <item name="windowSplashScreenAnimatedIcon">
            @drawable/splash_icon
        </item>

        <!-- تصویر ثابت است؛ انیمیشن اصلی در Compose اجرا می‌شود -->
        <item name="windowSplashScreenAnimationDuration">
            0
        </item>

        <item name="postSplashScreenTheme">
            @style/Theme.SolalrChef
        </item>

    </style>

</resources>
